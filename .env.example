# GEMINI_API_KEY: Required for server-side Gemini AI clinical explanations and report summaries.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public HTTPS URL where this applet is hosted.
APP_URL="MY_APP_URL"

# JWT_SECRET: Signing secret for VITALYNX session JWT tokens (keep secret on server only).
JWT_SECRET="replace-with-strong-random-jwt-secret"

# SQLITE_DB_PATH: Path to persisted SQLite database file.
SQLITE_DB_PATH="./vitalynx.db"

# Emergency Notifications:
# VITALYNX uses normal WhatsApp deep links (https://wa.me/<phone>?text=...) for registered guardians.
# No MSG91, SMS gateway API keys, WhatsApp Business API tokens, or DLT registration are required.

# Configurable Default Clinical Emergency Thresholds (can also be adjusted in Settings)
THRESHOLD_SPO2_SCALE1="89"
THRESHOLD_SPO2_SCALE2="84"
THRESHOLD_HR_HIGH="130"
THRESHOLD_HR_LOW="40"
THRESHOLD_RR_HIGH="25"
THRESHOLD_RR_LOW="8"
THRESHOLD_TEMP_HIGH="38.8"
THRESHOLD_TEMP_LOW="35.0"
THRESHOLD_NEWS2_CRITICAL="7"
ALERT_COOLDOWN_MINUTES="15"

# VITE_API_BASE_URL: Optional override for backend API base URL. Leave empty to use same-origin /api routes on port 3000.
VITE_API_BASE_URL=""
